# Hemoglobin AI backend configuration template
# Copy this file to .env, then replace placeholders with real values.
# Never commit backend/.env.

# ---------- Application ----------
APP_NAME=Hemoglobin AI API
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ---------- MongoDB ----------
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=hemoglobin_ai

# ---------- Authentication ----------
# Generate a value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------- Pinecone RAG ----------
# Install with: pip install pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=hemoglobin-knowledge
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=hemoglobin-knowledge

# ---------- Google Maps ----------
MAP_PROVIDER=hybrid
GOOGLE_MAPS_API_KEY=

# ---------- SMTP notifications ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
MAP_GEOCODING_PROVIDER=google
MAP_VISUAL_PROVIDER=mapbox
